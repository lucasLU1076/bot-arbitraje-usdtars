# Copia este archivo a ".env" (sin ".example") y completa tus credenciales reales ahi.
# NUNCA compartas este archivo ni pegues estos valores en un chat.
# Se generan en Bitso: Perfil > API (permisos de Trading; NO actives retiros).

BITSO_API_KEY=
BITSO_API_SECRET=

# Debe valer exactamente YES para permitir que el bot envie ordenes REALES.
# Si falta o es cualquier otro valor, el bot opera en modo simulado aunque
# config.yaml tenga dry_run: false. Es una segunda traba intencional.
BITSO_LIVE_CONFIRM=
